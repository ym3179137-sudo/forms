{
    "manifest_version": 3,
    "name": "Solver",
    "version": "1.0.0",
    "content_scripts": [
        {
            "matches": [
                "https://*.ixl.com/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "panel.css"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://docs.google.com/forms/*",
                "https://forms.gle/*"
            ],
            "js": [
                "forms.js"
            ],
            "css": [
                "panel.css"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://*.blooket.com/*"
            ],
            "js": [
                "blooket.js",
                "blooket-bypass.js"
            ],
            "css": [
                "panel.css"
            ],
            "run_at": "document_start"
        },
        {
            "matches": [
                "https://*.quizizz.com/*",
                "https://*.wayground.com/*"
            ],
            "js": [
                "wayground.js"
            ],
            "css": [
                "panel.css"
            ],
            "run_at": "document_idle"
        }
    ],
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://*/*"
    ]
}